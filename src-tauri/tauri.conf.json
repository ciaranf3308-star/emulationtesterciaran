{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": [
      {
        "center": true,
        "decorations": false,
        "fullscreen": false,
        "height": 1080,
        "label": "main",
        "resizable": true,
        "title": "Crystal Frontend",
        "width": 1920
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [],
    "targets": [
      "msi",
      "nsis"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3QTBGMkQ5RTlCOEI1MEIKUldRTHRianAyZktnRjIzVGp1T1V4ZXBJdWZoUG43VDVqRktNeEhhbHJsMEl6c1pNVGJBTGg0SWwK",
      "endpoints": [
        "https://github.com/ciaranf3308-star/emulationtesterciaran/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "identifier": "com.crystal.frontend",
  "productName": "Crystal Frontend",
  "version": "4.4.0"
}